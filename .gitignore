data/
models/
submissions/*
!submissions/README.md
!submissions/*_README.md
logs/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.venv/

# Track artifact metadata (json/csv) but not binary predictions, parquet,
# or submission CSVs (too large; the canonical copy lives in submissions/).
artifacts/**/*.npy
artifacts/**/*.parquet
artifacts/**/submission*.csv

# Saved LightGBM/XGBoost/CatBoost boosters are large (10–70 MB each).
# Keep them locally for reuse but never commit them.
diagnostics/**/*.txt
diagnostics/**/model_*.txt
diagnostics/**/*.parquet
artifacts/**/model_*.txt
*.lgb
*.cbm
*.xgb

# XGBoost saves models as .json — exclude when located in models/ subdirs only
diagnostics/**/models/**/*.json
artifacts/**/models/**/*.json

# But explicitly re-include diagnostic and submission READMEs that the
# patterns above would otherwise exclude (e.g. diagnostics/<run>/README.md).
!diagnostics/**/README.md
!diagnostics/**/*.md

# Per-row predictions (val/test) — multi-MB each, dozens per run.
*.npy

# Large diagnostic dumps (per-query disagreement files etc.)
diagnostics/**/v4_v5_disagreement*.csv
